#!/usr/bin/env bash
set -euo pipefail

output=${1:?missing output path}
source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source_file="$source_dir/bongo-input.c"

if [[ -x $output && $output -nt $source_file \
    && $output -nt ${BASH_SOURCE[0]} ]]; then
  exit 0
fi

command -v cc >/dev/null 2>&1 || {
  echo "No C compiler found (cc)." >&2
  exit 1
}

mkdir -p -- "$(dirname -- "$output")"
temporary="$output.tmp.$$"
trap 'rm -f -- "$temporary"' EXIT

cc -std=c17 -O2 -DNDEBUG -D_FORTIFY_SOURCE=3 \
  -Wall -Wextra -Wpedantic -Wformat=2 \
  -fstack-protector-strong -fPIE \
  "$source_file" -o "$temporary" \
  -pie -Wl,-z,relro,-z,now -Wl,-z,noexecstack
chmod 0755 "$temporary"
mv -f -- "$temporary" "$output"
trap - EXIT
